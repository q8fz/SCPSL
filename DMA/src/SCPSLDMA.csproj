<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DmaBase</RootNamespace>
    <AssemblyName>SCPSLDMA</AssemblyName>
    <TargetName>SCPSLDMA</TargetName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <DefineConstants>$(DefineConstants);DMA</DefineConstants>

    <!-- Single-file bundling for release publishing -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\..\..\Built\DMA\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VmmSharpEx" Version="3.200.12" />
    <PackageReference Include="ClickableTransparentOverlay" Version="9.2.0" />
    <IconFiles Include="$(MSBuildProjectDirectory)\Unity\Icons\*.png" />
  </ItemGroup>

  <Target Name="CopyIconsToOutDir" AfterTargets="Build">
    <Copy SourceFiles="@(IconFiles)" DestinationFolder="$(OutDir)Icons\" SkipUnchangedFiles="true" />
  </Target>

  <!-- Auto-publish single file on Release build so Built folder is always up-to-date -->
  <Target Name="AutoPublishRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(BuildingInsidePublish)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Publish" Properties="BuildingInsidePublish=true;Configuration=Release;RuntimeIdentifier=win-x64" />
  </Target>

  <!-- Post-publish hook: deploy only required native DLLs and clean out non-required files -->
  <Target Name="DeployRequiredFiles" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <RequiredDlls Include="$(MSBuildProjectDirectory)\..\vmm.dll" />
      <RequiredDlls Include="$(MSBuildProjectDirectory)\..\leechcore.dll" />
      <RequiredDlls Include="$(MSBuildProjectDirectory)\..\FTD3XX.dll" />
      <RequiredDlls Include="$(MSBuildProjectDirectory)\..\tinylz4.dll" />
      <RequiredDlls Include="$(MSBuildProjectDirectory)\..\symsrv.dll" />
      <RequiredDlls Include="$(MSBuildProjectDirectory)\..\dbghelp.dll" />
      <RequiredDlls Include="$(MSBuildProjectDirectory)\..\leechcore_driver.dll" />
    </ItemGroup>

    <!-- Copy strictly required native DLLs to publish destination (NEVER copy mmap.txt) -->
    <Copy SourceFiles="@(RequiredDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <Copy SourceFiles="@(IconFiles)" DestinationFolder="$(PublishDir)Icons\" SkipUnchangedFiles="true" />

    <!-- Remove PDBs, vcruntime140.dll, mmap.txt, and extraneous files -->
    <ItemGroup>
      <FilesToRemove Include="$(PublishDir)*.pdb" />
      <FilesToRemove Include="$(PublishDir)vcruntime140.dll" />
      <FilesToRemove Include="$(PublishDir)*.deps.json" />
      <FilesToRemove Include="$(PublishDir)*.runtimeconfig.json" />
      <FilesToRemove Include="$(PublishDir)DmaBase.dll" />
      <FilesToRemove Include="$(PublishDir)scpslDMA.dll" />
      <FilesToRemove Include="$(PublishDir)SCPSLDMA.dll" />
      <FilesToRemove Include="$(PublishDir)ClickableTransparentOverlay.dll" />
      <FilesToRemove Include="$(PublishDir)Collections.Pooled.dll" />
      <FilesToRemove Include="$(PublishDir)ImGui.NET.dll" />
      <FilesToRemove Include="$(PublishDir)SharpGen.*.dll" />
      <FilesToRemove Include="$(PublishDir)SixLabors.*.dll" />
      <FilesToRemove Include="$(PublishDir)VmmSharpEx.dll" />
      <FilesToRemove Include="$(PublishDir)Vortice.*.dll" />
      <FilesToRemove Include="$(PublishDir)cimgui.dll" />
      <FilesToRemove Include="$(PublishDir)imgui.ini" />
      <FilesToRemove Include="$(PublishDir)mmap.txt" />
    </ItemGroup>
    <Delete Files="@(FilesToRemove)" TreatErrorsAsWarnings="true" />
  </Target>

</Project>
